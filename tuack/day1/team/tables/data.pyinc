ret = [["测试点","$n\le $","特殊性质"]]	#注意右斜杠经常需要两次转义
ret.append(["$1\sim 2$","20","无"])
ret.append(["$3$","100","无"])
ret.append(["$4\sim 5$","500","无"])
ret.append(["$6\sim 7$","1000","无"])
ret.append(["$8\sim 9$","5000","无"])
ret.append(["$10\sim 11$","3\\times 10^5","$v_i \le 10$"])
ret.append(["$12\sim 14$","10^5","无"])	
ret.append(["$15\sim 17$","2\\times 10^5","无"])
ret.append(["$18\sim 20$","3\\times 10^5","无"])
base.log.debug(u'输出调试信息')	#渲染题面时会在控制台输出需要调试的信息，不需要可以删除
return ret	#现在不用merge_ver函数也会自动合并了
