ret = [["测试点","$n\le $","特殊性质"]]	#注意右斜杠经常需要两次转义
ret.append(["$1\sim 3$", "$10$", "无"])
ret.append(["$4\sim 6$", "$100$", "无"])
ret.append(["$7\sim 10$", "$5000$", "无"])
ret.append(["$11\sim 12$", "$5\\times 10^4$", "无"])
ret.append(["$13\sim 15$", "$10^5$", "$v_i$ 随机生成"])
ret.append(["$16\sim 20$", "$10^5$", "无"])
base.log.debug(u'输出调试信息')	#渲染题面时会在控制台输出需要调试的信息，不需要可以删除
return ret	#现在不用merge_ver函数也会自动合并了
